# --- Database (structured data) ---
# For quick local runs SQLite is used automatically if DATABASE_URL is left blank.
# For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://insuresync:insuresync@localhost:5432/insuresync
DATABASE_URL=

# --- MongoDB (unstructured medical documents) ---
# Optional. If unset, the document store gracefully falls back to local disk storage.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=insuresync_docs

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- LLM Advisor ---
# Optional. If unset, the advisor uses a built-in rule-based template engine
# so the app is fully demoable without any API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173
